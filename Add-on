struct Video: Identifiable, Codable {
    let id: String
    let title: String
    let youtubeURL: String
    let category: String   // 👈 KEY PART
}
----------------------------------------
ViewModel
------------------------------
class VideoViewModel: ObservableObject {
    @Published var videos: [Video] = []
    
    func fetchVideos() {
        guard let url = URL(string: "https://your-api-url/videos") else { return }
        
        URLSession.shared.dataTask(with: url) { data, _, _ in
            if let data = data {
                if let decoded = try? JSONDecoder().decode([Video].self, from: data) {
                    DispatchQueue.main.async {
                        self.videos = decoded
                    }
                }
            }
        }.resume()
    }
}
