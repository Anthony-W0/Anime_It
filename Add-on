struct VideoFeedView: View {
    
    @StateObject var vm = VideoViewModel()
    
    var groupedVideos: [String: [Video]] {
        Dictionary(grouping: vm.videos) { $0.category }
    }
    
    var body: some View {
        NavigationView {
            List {
                ForEach(groupedVideos.keys.sorted(), id: \.self) { category in
                    
                    Section(header: Text(category)) {
                        ForEach(groupedVideos[category] ?? []) { video in
                            VideoRow(video: video)
                        }
                    }
                }
            }
            .navigationTitle("Tutorial Videos")
        }
        .onAppear {
            vm.fetchVideos()
        }
    }
}
