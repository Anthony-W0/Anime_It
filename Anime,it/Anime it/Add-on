import SwiftUI
import PhotosUI

struct EditableProfileView: View {
    
    @State private var user = LocalUser(
        username: "YourName",
        bio: "Your bio here...",
        profileImage: nil,
        followers: 120,
        following: 180,
        posts: []
    )
    
    @State private var selectedItem: PhotosPickerItem?
    @State private var selectedPost: UserPost?   // ✅ FIXED POSITION
    
    var body: some View {
        ScrollView {
            VStack(spacing: 16) {
                
                // 👤 Profile Image
                if let image = user.profileImage {
                    Image(uiImage: image)
                        .resizable()
                        .frame(width: 90, height: 90)
                        .clipShape(Circle())
                } else {
                    Circle()
                        .fill(Color.gray.opacity(0.3))
                        .frame(width: 90, height: 90)
                }
                
                // ✏️ Name
                TextField("Username", text: $user.username)
                    .textFieldStyle(RoundedBorderTextFieldStyle())
                    .padding(.horizontal)
                
                // ✏️ Bio
                TextField("Bio", text: $user.bio)
                    .textFieldStyle(RoundedBorderTextFieldStyle())
                    .padding(.horizontal)
                
                // 📊 Stats
                HStack(spacing: 20) {
                    StatView(value: user.posts.count, title: "Posts")
                    StatView(value: user.followers, title: "Followers")
                    StatView(value: user.following, title: "Following")
                }
                
                Divider()
                
                // ➕ Add Post
                PhotosPicker(selection: $selectedItem, matching: .images) {
                    Text("Add Post")
                        .bold()
                        .frame(maxWidth: .infinity)
                        .padding()
                        .background(Color.blue)
                        .foregroundColor(.white)
                        .cornerRadius(10)
                        .padding(.horizontal)
                }
                
                // 📸 GRID
                LazyVGrid(columns: [
                    GridItem(.flexible()),
                    GridItem(.flexible()),
                    GridItem(.flexible())
                ], spacing: 2) {
                    
                    ForEach(user.posts) { post in
                        Image(uiImage: post.image)
                            .resizable()
                            .scaledToFill()
                            .frame(height: 120)
                            .clipped()
                            .onTapGesture {
                                selectedPost = post   // 🔍 open
                            }
                            .contextMenu {
                                Button(role: .destructive) {
                                    deletePost(post)
                                } label: {
                                    Text("Delete")
                                }
                            }
                    }
                }
            }
        }
        .onChange(of: selectedItem) {
            loadImage()
        }
        .sheet(item: $selectedPost) { post in
            fullScreenView(post)
        }
    }
    
    // 🔍 Full Screen View
    func fullScreenView(_ post: UserPost) -> some View {
        ZStack(alignment: .topTrailing) {
            
            Color.black.ignoresSafeArea()
            
            Image(uiImage: post.image)
                .resizable()
                .scaledToFit()
            
            Button("Done") {
                selectedPost = nil
            }
            .padding()
            .foregroundColor(.white)
        }
    }
    
    // 🗑 Delete
    func deletePost(_ post: UserPost) {
        user.posts.removeAll { $0.id == post.id }
    }
    
    // 📥 Load Image
    func loadImage() {
        guard let selectedItem else { return }
        
        Task {
            if let data = try? await selectedItem.loadTransferable(type: Data.self),
               let uiImage = UIImage(data: data) {
                
                DispatchQueue.main.async {
                    let newPost = UserPost(
                        id: UUID(),
                        image: uiImage,
                        likes: Int.random(in: 0...200)
                    )
                    
                    user.posts.append(newPost)
                }
            }
        }
    }
}

